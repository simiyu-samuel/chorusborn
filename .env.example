# Local server-side Twitch OAuth configuration.
# Copy to .env locally. Real credentials must never be committed.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3001/auth/twitch/callback
TWITCH_CHANNEL=developersimiyu
WEB_ORIGIN=http://localhost:5173

# Optional server-side natural-language compiler. Never expose in VITE_ variables.
GROQ_API_KEY=
