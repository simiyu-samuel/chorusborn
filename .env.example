# Local server-side Twitch OAuth configuration.
# Copy to .env locally. Real credentials must never be committed.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3001/auth/twitch/callback
# Legacy initial setup hint; each broadcaster is independently verified.
TWITCH_CHANNEL=developersimiyu
WEB_ORIGIN=http://localhost:5173

# Optional server-side natural-language compiler. Never expose in VITE_ variables.
GROQ_API_KEY=

# Cloud runtime only (set in Vercel production, not in VITE_ variables).
# The daemon derives its Twitch callback from PUBLIC_ORIGIN + /auth/twitch/callback.
# PUBLIC_ORIGIN=https://your-project.vercel.app
# REDIS_URL=rediss://...          # provisioned by Vercel Marketplace
# CHORUSBORN_STATE_KEY=           # 32 random bytes encoded as 64 hex characters
